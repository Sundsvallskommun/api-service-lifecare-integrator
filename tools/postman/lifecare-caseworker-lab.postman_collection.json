					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"const items = pm.response.json().Result ?? [];",
									"items.forEach(i => console.log(`utredning ${i.Id}: Caseworker='${i.Caseworker}'`));",
									"console.log('Notera: samma mönster som beslut — namn, inget id.');"
								]
							}
						}
					],
					"request": {
