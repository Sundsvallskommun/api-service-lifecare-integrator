				{
					"name": "Aktualiseringsförslag (enda stället FC ger ett CaseworkerId)",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"const body = pm.response.json();",
									"const raw = JSON.stringify(body);",
									"",
									"// CaseworkerId finns enligt specen bara på PersonBasedAktualiseringsInvestigationDTO / -ServiceDTO,",
									"// dvs i förslags-svaret — inte på något beslut.",
									"const ids = [...raw.matchAll(/\"CaseworkerId\"\\s*:\\s*\"?([^\",}]+)\"?/g)].map(m => m[1]);",
									"",
									"if (ids.length) {",
									"    console.log('CaseworkerId hittade i förslaget:', ids.join(', '));",
									"    console.log('Jämför formatet med EC:s Caseworker.Id och med FC User.Id — samma rymd?');",
									"    pm.collectionVariables.set('fcUserId', ids[0]);",
									"    console.log(`fcUserId satt till ${ids[0]} — kör 'Slå upp userId' i mapp 4`);",
									"} else {",
									"    console.log('Inga CaseworkerId i förslaget för den här personen.');",
									"}"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{fcBaseUrl}}/apifc/v1/Actualisations/Proposals?personId={{testPersonId}}&domain={{domain}}&key={{key}}",
							"host": [
