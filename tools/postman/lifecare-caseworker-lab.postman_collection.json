{
	"info": {
		"name": "Lifecare — handläggarlabb (EC + FC)",
		"description": "Labb för HYDRAN-2629: vad returnerar Lifecare EC och FC om handläggaren som fattat beslutet, och går det att koppla vidare till Employee-tjänsten?\n\nKärnfrågan: ligger EC:s Caseworker.Id i samma id-rymd som User.Id? Om ja finns kedjan Caseworker.Id -> User -> NetworkUserId -> Employee /portalpersondata/{domain}/{loginName}. Om nej är enrichment dött även för EC.\n\nFör FC är frågan redan avgjord av specen: PersonBasedDecisionDTO.DecisionMaker är en bar sträng utan id. Mapp 3 finns för att bekräfta det mot verkligt data.\n\nSE UPP: personnummer och API-nyckeln reser i query-strängen. Dela inte körhistorik, exportera inte miljön med nyckeln i, och logga inte svaren vidare.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "apikey",
		"apikey": [
			{
				"key": "key",
				"value": "X-API-Key",
				"type": "string"
			},
			{
				"key": "value",
				"value": "{{key}}",
				"type": "string"
			},
			{
				"key": "in",
				"value": "header",
				"type": "string"
			}
		]
	},
	"variable": [
		{
			"key": "ecBaseUrl",
			"value": "https://lifecare-ext.sundsvall.se/WE.EC.Integration.Host",
			"type": "string"
		},
		{
			"key": "fcBaseUrl",
			"value": "https://lifecare-ext.sundsvall.se/WESE.FC.Api.FC",
			"type": "string"
		},
		{
			"key": "ecCaseworkerId",
			"value": "",
			"type": "string",
			"description": "Fylls automatiskt av testskriptet i EC-beslutsanropen"
		},
		{
			"key": "fcUserId",
			"value": "",
			"type": "string",
			"description": "Fylls automatiskt av GetUsers"
		}
	],
	"item": [
		{
			"name": "1. EC — vad beslutet ger om handläggaren",
			"item": [
				{
					"name": "SoL-beslut för person",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"const decisions = pm.response.json();",
									"",
									"pm.test('Svaret är en lista med beslut', () => {",
									"    pm.expect(decisions).to.be.an('array');",
									"});",
									"",
									"const withCaseworker = decisions.filter(d => d.Caseworker);",
									"console.log(`${decisions.length} SoL-beslut, ${withCaseworker.length} med Caseworker satt`);",
									"",
									"withCaseworker.forEach(d => console.log(`beslut ${d.Id}:`, JSON.stringify(d.Caseworker)));",
									"",
									"// Spara första Caseworker.Id — det är indata till id-rymdstestet i mapp 2.",
									"const id = withCaseworker[0]?.Caseworker?.Id;",
									"if (id) {",
									"    pm.collectionVariables.set('ecCaseworkerId', id);",
									"    console.log(`ecCaseworkerId satt till ${id} — kör nu 'Slå upp Caseworker.Id som User' i mapp 2`);",
									"} else {",
									"    console.warn('Inget Caseworker.Id i svaret — prova annan testperson eller LSS-beslut');",
									"}"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{ecBaseUrl}}/api/v1/sol_decisions?q=PersonId:{{testPersonId}}&limit=10&domain={{domain}}&key={{key}}",
							"host": [
								"{{ecBaseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"sol_decisions"
							],
							"query": [
								{
									"key": "q",
									"value": "PersonId:{{testPersonId}}"
								},
								{
									"key": "limit",
									"value": "10"
								},
								{
									"key": "domain",
									"value": "{{domain}}"
								},
								{
									"key": "key",
									"value": "{{key}}"
								}
							]
						},
						"description": "Titta på Caseworker-objektet: Id, FirstName, LastName, FullName, Types[], OrganizationUnit{Id,Name}.\n\nIdag mappar DecisionMapper bara FullName till Decision.decisionMaker och slänger Id + OrganizationUnit. Frågan att svara på här: är FullName och OrganizationUnit.Name ifyllda på riktigt data, eller är de tomma/felaktiga i praktiken?"
					}
				},
				{
					"name": "LSS-beslut för person (Caseworker + SfbCaseworker)",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"const decisions = pm.response.json();",
									"",
									"decisions.forEach(d => {",
									"    console.log(`beslut ${d.Id} Caseworker:`, JSON.stringify(d.Caseworker));",
									"    if (d.SfbCaseworker) {",
									"        console.log(`beslut ${d.Id} SfbCaseworker:`, JSON.stringify(d.SfbCaseworker));",
									"    }",
									"});",
									"",
									"// Sätt bara om SoL-anropet inte redan hittat ett id.",
									"const id = decisions.find(d => d.Caseworker?.Id)?.Caseworker?.Id;",
									"if (id && !pm.collectionVariables.get('ecCaseworkerId')) {",
									"    pm.collectionVariables.set('ecCaseworkerId', id);",
									"    console.log(`ecCaseworkerId satt till ${id}`);",
									"}"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{ecBaseUrl}}/api/v1/lss_decisions?q=PersonId:{{testPersonId}}&limit=10&domain={{domain}}&key={{key}}",
							"host": [
								"{{ecBaseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"lss_decisions"
							],
							"query": [
								{
									"key": "q",
									"value": "PersonId:{{testPersonId}}"
								},
								{
									"key": "limit",
									"value": "10"
								},
								{
									"key": "domain",
									"value": "{{domain}}"
								},
								{
									"key": "key",
									"value": "{{key}}"
								}
							]
						},
						"description": "LSS-beslut har både Caseworker och SfbCaseworker (samma Caseworker-typ). Kolla om SfbCaseworker.Id ligger i samma rymd som Caseworker.Id."
					}
				}
			]
		},
		{
			"name": "2. EC — id-rymdstestet (kärnan i labben)",
			"item": [
				{
					"name": "Slå upp Caseworker.Id som User",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"type": "text/javascript",
								"exec": [
									"if (!pm.collectionVariables.get('ecCaseworkerId')) {",
									"    throw new Error('ecCaseworkerId är tom — kör ett beslutsanrop i mapp 1 först');",
									"}"
								]
							}
						},
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"const caseworkerId = pm.collectionVariables.get('ecCaseworkerId');",
									"",
									"// DETTA är hela labbens svar.",
									"if (pm.response.code === 200) {",
									"    const user = pm.response.json();",
									"    console.log(`JA — Caseworker.Id ${caseworkerId} löser till en User.`);",
									"    console.log('NetworkUserId:', user.NetworkUserId, '| HsaId:', user.HsaId, '| FullName:', user.FullName);",
									"",
									"    pm.test('User har NetworkUserId (= inloggningsnamn mot Employee)', () => {",
									"        pm.expect(user.NetworkUserId).to.be.a('string').and.not.empty;",
									"    });",
									"",
									"    if (user.NetworkUserId) {",
									"        console.log(`Kedjan håller: prova nu Employee GET /api/v1/employee/portalpersondata/{domain}/${user.NetworkUserId}`);",
									"    }",
									"} else if (pm.response.code === 404) {",
									"    console.log(`NEJ — Caseworker.Id ${caseworkerId} finns inte som User. Skilda id-rymder => enrichment är dött även för EC.`);",
									"} else {",
									"    console.log(`Oklart — status ${pm.response.code}. Kolla att domain/key gäller users-endpointen också.`);",
									"}"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{ecBaseUrl}}/api/v1/users/{{ecCaseworkerId}}?domain={{domain}}&key={{key}}",
							"host": [
								"{{ecBaseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"users",
								"{{ecCaseworkerId}}"
							],
							"query": [
								{
									"key": "domain",
									"value": "{{domain}}"
								},
								{
									"key": "key",
									"value": "{{key}}"
								}
							]
						},
						"description": "Kärntestet. Tar id:t från Caseworker-objektet på ett beslut och försöker slå upp det som en User.\n\n200 + NetworkUserId => kedjan Caseworker.Id -> User -> NetworkUserId -> Employee finns, och enrichment är tekniskt möjlig för EC.\n404 => skilda id-rymder, enrichment omöjlig även för EC.\n\nOBS att svaret på den tekniska frågan inte automatiskt gör enrichment till rätt beslut — Employee ger nuvarande namn, inte namnet som gällde vid beslutstillfället."
					}
				},
				{
					"name": "Lista users (se id-format och NetworkUserId)",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"const users = pm.response.json();",
									"const sample = (Array.isArray(users) ? users : []).slice(0, 5);",
									"",
									"console.log('Id-format hos EC-users:');",
									"sample.forEach(u => console.log(`  Id=${u.Id} | NetworkUserId=${u.NetworkUserId} | HsaId=${u.HsaId} | ${u.FullName}`));",
									"",
									"const caseworkerId = pm.collectionVariables.get('ecCaseworkerId');",
									"if (caseworkerId) {",
									"    console.log(`Jämför med Caseworker.Id=${caseworkerId} — ser det ut som samma format?`);",
									"}"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{ecBaseUrl}}/api/v1/users?limit=50&domain={{domain}}&key={{key}}",
							"host": [
								"{{ecBaseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"users"
							],
							"query": [
								{
									"key": "limit",
									"value": "50"
								},
								{
									"key": "domain",
									"value": "{{domain}}"
								},
								{
									"key": "key",
									"value": "{{key}}"
								}
							]
						},
						"description": "Backup om by-id-uppslaget ger 404: titta på id-formatet i listan och jämför med Caseworker.Id. Skiljer sig formaten (t.ex. GUID vs löpnummer) är svaret nej direkt, utan gissningar."
					}
				}
			]
		},
		{
			"name": "3. FC — bekräfta att beslutet bara ger ett namn",
			"item": [
				{
					"name": "Beslut för person (DecisionMaker som sträng)",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"const decisions = pm.response.json().Result ?? [];",
									"",
									"console.log(`${decisions.length} FC-beslut`);",
									"decisions.forEach(d => console.log(`  beslut ${d.Id}: DecisionMaker='${d.DecisionMaker}' | Organization='${d.Organization}'`));",
									"",
									"pm.test('DecisionMaker är en sträng utan id (specens påstående håller)', () => {",
									"    decisions.forEach(d => {",
									"        if (d.DecisionMaker !== null && d.DecisionMaker !== undefined) {",
									"            pm.expect(d.DecisionMaker).to.be.a('string');",
									"        }",
									"    });",
									"});",
									"",
									"const anyId = decisions.some(d => d.CaseworkerId || d.Caseworker?.Id);",
									"if (anyId) {",
									"    console.warn('ÖVERRASKNING: ett FC-beslut bar ändå ett caseworker-id — specen är i så fall ofullständig, gräv vidare.');",
									"} else {",
									"    console.log('Bekräftat: inget id på FC-beslut. Enrichment på FC-beslut är omöjlig — bara namnet finns.');",
									"}"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{fcBaseUrl}}/apifc/v1/Decisions?personId={{testPersonId}}&startDate={{startDate}}&endDate={{endDate}}&pageSize=10&domain={{domain}}&key={{key}}",
							"host": [
