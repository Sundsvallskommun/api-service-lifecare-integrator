		},
		{
			"name": "4. FC — users (id-rymd och NetworkUserId)",
			"item": [
				{
					"name": "Lista users",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"const body = pm.response.json();",
									"const users = Array.isArray(body) ? body : (body.Result ?? []);",
									"",
									"console.log('Id-format hos FC-users:');",
									"users.slice(0, 5).forEach(u => console.log(`  Id=${u.Id} | NetworkUserId=${u.NetworkUserId} | HsaId=${u.HsaId} | ${u.FullName}`));",
									"",
									"if (users[0]?.Id && !pm.collectionVariables.get('fcUserId')) {",
									"    pm.collectionVariables.set('fcUserId', users[0].Id);",
									"}",
									"",
									"// Kan vi matcha DecisionMaker-strängen mot en user på namn? Kolla hur unikt FullName är.",
									"const names = users.map(u => u.FullName).filter(Boolean);",
									"const dupes = names.filter((n, i) => names.indexOf(n) !== i);",
									"if (dupes.length) {",
									"    console.warn('Dubbletter i FullName:', [...new Set(dupes)].join(', '));",
									"    console.warn('=> namnmatchning mot DecisionMaker är inte deterministisk. Ännu ett skäl att inte gå den vägen.');",
									"} else {",
									"    console.log(`${names.length} namn, inga dubbletter i det här urvalet — men det bevisar inte unikhet i hela beståndet.`);",
									"}"
								]
							}
						}
